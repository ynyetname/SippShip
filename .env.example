# Reference only: SippShip does not load this file automatically.
# Set these as shell environment variables before starting the service.
SIPPSHIP_DATA_DIR=.sippship
SIPPSHIP_API_URL=http://127.0.0.1:8000
SIPPSHIP_RUNNER_IMAGE=sippship-runner:py312

# IBM Bob MCP is the default reasoning path; no additional API key is required.
SIPPSHIP_MODEL_PROVIDER=bob
# Optional API automation (choose a model your provider account can use):
# SIPPSHIP_MODEL_PROVIDER=openai-compatible
# SIPPSHIP_MODEL_BASE_URL=https://api.openai.com/v1
# SIPPSHIP_MODEL=YOUR_MODEL_ID
# SIPPSHIP_MODEL_API_KEY=YOUR_SECRET
# Anthropic: provider=anthropic, base URL=https://api.anthropic.com/v1

# Optional private repository access / explicit GitHub reporting:
# SIPPSHIP_GITHUB_TOKEN=YOUR_SECRET
# Optional signed PR event intake:
# SIPPSHIP_WEBHOOK_SECRET=YOUR_RANDOM_SECRET

# Opt-in only for trusted local code; this is not a security sandbox:
# SIPPSHIP_ALLOW_LOCAL_EXECUTION=1

# Owner and agent credentials are generated locally on first startup.
# Never commit token files, real API keys, or the generated data directory.
