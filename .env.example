# No model API key is needed: IBM Bob acts as the reasoning host.
# These are optional shell environment variables. The app does not load .env automatically.
SIPPSHIP_DATA_DIR=.sippship
SIPPSHIP_API_URL=http://127.0.0.1:8000
SIPPSHIP_RUNNER_IMAGE=sippship-runner:py312
# Local operator/agent credentials are generated by configure-bob or API startup.
# The MCP adapter receives only the agent credential path, never the operator token.
